---
const categories = ['교육 정보', '양육 정보', '생활 정보', '놀이 학습 자료', '심리 치료 공부'];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true">딸</span>
      <span class="logo-text">
        <span class="logo-name">딸기핑크</span>
        <span class="logo-tagline">육아 · 교육 · 심리 이야기</span>
      </span>
    </a>
    <nav class="nav" aria-label="카테고리">
      {categories.map((c) => (
        <a href={`/category/${encodeURIComponent(c)}/`}>{c}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
    background: rgba(250, 245, 236, 0.86);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-ink);
  }

  .logo:hover {
    color: var(--color-ink);
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff8ef;
    font-family: var(--font-display);
    font-size: 18px;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
  }

  .logo-tagline {
    font-size: 12px;
    color: var(--color-ink-soft);
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }

  .nav a {
    font-size: 14.5px;
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .nav {
      gap: 14px;
      font-size: 13.5px;
    }
  }
</style>
