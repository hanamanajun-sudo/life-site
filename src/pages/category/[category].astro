---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))];
  return categories.map((category) => ({
    params: { category },
    props: {
      posts: posts
        .filter((p) => p.data.category === category)
        .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()),
    },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`${category} 글 모음`} description={`딸기핑크의 ${category} 카테고리 글 모음`}>
  <Header />
  <main>
    <section class="container header-block">
      <p class="eyebrow">카테고리</p>
      <h1>{category}</h1>
    </section>
    <section class="container">
      <div class="grid">
        {posts.map((post) => (
          <PostCard {...post.data} />
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .header-block {
    padding: 56px 24px 32px;
  }
  .header-block h1 {
    margin: 12px 0 0;
    font-size: clamp(28px, 4vw, 38px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    padding-bottom: 80px;
  }
</style>
