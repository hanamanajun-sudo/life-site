---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  category?: string;
  date: string;
  thumbnail?: string;
}

const { title, description, category, date, thumbnail } = Astro.props;

const formatted = new Date(date).toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} image={thumbnail} type="article" publishedTime={date}>
  <Header />
  <main>
    <article class="post">
      <header class="post-header content-width">
        {category && <a class="eyebrow" href={`/category/${encodeURIComponent(category)}/`}>{category}</a>}
        <h1>{title}</h1>
        <time datetime={date}>{formatted}</time>
      </header>

      {thumbnail && (
        <div class="hero-image container">
          <img src={thumbnail} alt="" />
        </div>
      )}

      <div class="post-body content-width">
        <slot />
      </div>

      <div class="post-footer content-width">
        <a href="/" class="back-link">&larr; 홈으로 돌아가기</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .post-header {
    padding: 56px 24px 32px;
    text-align: center;
  }

  .post-header h1 {
    font-size: clamp(28px, 4.5vw, 40px);
    margin: 14px 0 16px;
  }

  .post-header time {
    font-size: 13.5px;
    color: var(--color-ink-faint);
  }

  .hero-image {
    margin-bottom: 40px;
    border-radius: var(--radius-card);
    overflow: hidden;
    max-width: var(--wide-width);
  }

  .hero-image img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .post-footer {
    padding: 48px 24px 96px;
    border-top: 1px solid var(--color-line);
    margin-top: 56px;
  }

  .back-link {
    font-size: 14.5px;
    text-decoration: none;
    color: var(--color-ink-soft);
  }

  .back-link:hover {
    color: var(--color-accent);
  }
</style>

<style is:global>
  .post-body {
    padding: 0 24px;
    font-size: 17px;
    line-height: 1.9;
    color: var(--color-ink);
  }

  .post-body p {
    margin: 0 0 22px;
  }

  .post-body h2 {
    font-size: 24px;
    margin: 44px 0 18px;
    padding-top: 4px;
  }

  .post-body h3 {
    font-size: 19.5px;
    margin: 34px 0 14px;
    color: var(--color-accent-deep);
  }

  .post-body a {
    color: var(--color-accent);
    text-decoration-line: underline;
  }

  .post-body figure {
    margin: 32px 0;
  }

  .post-body figure img {
    border-radius: var(--radius-card);
    margin: 0 auto;
  }

  .post-body figcaption {
    text-align: center;
    font-size: 13px;
    color: var(--color-ink-faint);
    margin-top: 8px;
  }

  .post-body hr {
    border: none;
    border-top: 1px solid var(--color-line);
    margin: 40px 0;
  }

  .post-body b,
  .post-body strong {
    color: var(--color-ink);
  }

  .post-body iframe {
    max-width: 100%;
  }

  .post-body figure:has(> iframe) {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .post-body figure:has(> iframe) iframe {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-card);
  }
</style>
