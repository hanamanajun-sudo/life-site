---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description = '육아, 자녀 교육, 심리 상식을 담은 부모를 위한 정보 사이트',
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = '딸기핑크';
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebSite',
  name: pageTitle,
  headline: title,
  description,
  url: canonicalURL.toString(),
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  ...(ogImage ? { image: ogImage } : {}),
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- 서치콘솔 소유확인 (구 티스토리 <head>에서 이식, 이전 후 재인증 없이 유지) -->
    <meta name="google-site-verification" content="i_uC8RSsjsJRq3k8cJf85Fsa20seZolMNMdtRRpzVew" />
    <meta name="google-site-verification" content="8vweZoYIYHsV8uXwGWWPFFNKo9tMD957TTHbB3N3USQ" />
    <meta name="naver-site-verification" content="e4a262b616457ea61099c057c79675d92028a2fd" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
